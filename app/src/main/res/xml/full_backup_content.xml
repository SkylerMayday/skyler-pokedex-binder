<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 equivalent of data_extraction_rules.xml — keep the two in sync. Exclusions only,
    so every other file the app owns is still backed up exactly as it was before.
-->
<full-backup-content>
    <!-- EncryptedSharedPreferences: ciphertext is useless without this device's Keystore master key;
         restoring it crashes on decrypt. -->
    <exclude domain="sharedpref" path="settings_secrets.xml" />
    <exclude domain="sharedpref" path="publish_secrets.xml" />
    <exclude domain="file" path="exports/" />
    <!-- One-shot pending-error message, must never survive a device transfer. -->
    <exclude domain="sharedpref" path="backup_import_state.xml" />
</full-backup-content>
