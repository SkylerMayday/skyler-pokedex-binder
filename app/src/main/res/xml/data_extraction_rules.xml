<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) Auto Backup / device-transfer policy. Only exclusions are listed, so
    everything else — including the Room database itself — keeps the default include behaviour it
    had before this file existed.

    filesDir/exports/ holds up to MAX_EXPORTS full copies of the database written by BackupExporter.
    They are share-sheet artefacts Skyler has already sent somewhere else; re-uploading each one to
    the cloud-backup quota on top of the live database is pure waste.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- EncryptedSharedPreferences: ciphertext is useless without this device's Keystore master key;
             restoring it crashes on decrypt. -->
        <exclude domain="sharedpref" path="settings_secrets.xml" />
        <exclude domain="sharedpref" path="publish_secrets.xml" />
        <!-- KeystoreSecretStore (v2): the AES key never leaves this device, so the ciphertext is useless elsewhere. -->
        <exclude domain="sharedpref" path="settings_secrets_v2.xml" />
        <exclude domain="sharedpref" path="publish_secrets_v2.xml" />
        <exclude domain="file" path="exports/" />
        <!-- One-shot pending-error message, must never survive a device transfer. -->
        <exclude domain="sharedpref" path="backup_import_state.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- EncryptedSharedPreferences: ciphertext is useless without this device's Keystore master key;
             restoring it crashes on decrypt. -->
        <exclude domain="sharedpref" path="settings_secrets.xml" />
        <exclude domain="sharedpref" path="publish_secrets.xml" />
        <!-- KeystoreSecretStore (v2): the AES key never leaves this device, so the ciphertext is useless elsewhere. -->
        <exclude domain="sharedpref" path="settings_secrets_v2.xml" />
        <exclude domain="sharedpref" path="publish_secrets_v2.xml" />
        <exclude domain="file" path="exports/" />
        <!-- One-shot pending-error message, must never survive a device transfer. -->
        <exclude domain="sharedpref" path="backup_import_state.xml" />
    </device-transfer>
</data-extraction-rules>
