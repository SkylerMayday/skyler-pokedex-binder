<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) Auto Backup / device-transfer policy. Only exclusions are listed, so
    everything else — including the Room database itself — keeps the default include behaviour it
    had before this file existed.

    filesDir/exports/ holds up to MAX_EXPORTS full copies of the database written by BackupExporter.
    They are share-sheet artefacts Skyler has already sent somewhere else; re-uploading each one to
    the cloud-backup quota on top of the live database is pure waste.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="exports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="exports/" />
    </device-transfer>
</data-extraction-rules>
